{
  "rules": {
    "posts": {
      ".read": true,
      "$section": {
        "$postId": {
          ".write": "auth != null && auth.token.email == 'aymanc366@gmail.com' && auth.token.email_verified == true"
        }
      }
    },

    "users": {
      ".read": "auth != null && auth.token.email == 'aymanc366@gmail.com' && auth.token.email_verified == true",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || (auth.token.email == 'aymanc366@gmail.com' && auth.token.email_verified == true))",
        ".write": "auth != null && (auth.uid == $uid || (auth.token.email == 'aymanc366@gmail.com' && auth.token.email_verified == true))",
        "memberTypes": {
          ".validate": "!newData.exists() || newData.hasChild('0') || newData.hasChild('1') || newData.hasChild('2')",
          "$index": {
            ".validate": "($index == '0' || $index == '1' || $index == '2') && newData.isString() && (newData.val() == 'P.S' || newData.val() == 'C.D' || newData.val() == 'S.P.L' || newData.val() == 'P.L' || newData.val() == 'A.P.L' || newData.val() == 'MEMBER')"
          }
        }
      }
    },

    "attendance": {
      ".read": "auth != null && auth.token.email == 'aymanc366@gmail.com' && auth.token.email_verified == true",
      "$uid": {
        ".read": "auth != null && auth.token.email == 'aymanc366@gmail.com' && auth.token.email_verified == true",
        "$date": {
          ".write": "auth != null && auth.token.email == 'aymanc366@gmail.com' && auth.token.email_verified == true",
          ".validate": "newData.hasChildren(['date','markedBy','verification','recordedAt']) && newData.child('date').isString() && newData.child('markedBy').isString() && newData.child('verification').isString()"
        }
      }
    },

    "shop": {
      ".read": true,
      "$productId": {
        ".write": "auth != null && auth.token.email == 'aymanc366@gmail.com' && auth.token.email_verified == true"
      }
    }
  }
}
